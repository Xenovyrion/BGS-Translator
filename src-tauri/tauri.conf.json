{
  "productName": "BGS Translator",
  "version": "1.0.0",
  "identifier": "io.github.bgstranslator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BGS Translator",
        "width": 1400,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRDU4QTdFNjk2OUU3RjIKUldUeTUybHBmb3JWUWFnUnlZQ3B0dlNIKzNTejlZTTNka1hZc0F0UEk4OGkvaFp6RFh6ZFF6YzkK",
      "endpoints": [
        "https://github.com/Xenovyrion/BGS-Translator/releases/latest/download/latest.json"
      ]
    }
  }
}
